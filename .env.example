# Copy this file to `.env.local` and fill in the values.
# POSTGRES_URL and BETTER_AUTH_SECRET are REQUIRED — the app refuses to boot
# without them (validated at startup by src/lib/env.ts).

# Database (matches docker-compose.yml defaults)
POSTGRES_URL=postgresql://dev_user:dev_password@localhost:5432/postgres_dev

# Better Auth — generate a 32+ character random secret (e.g. `openssl rand -base64 32`)
# Docs: https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=your-secret-key-here

# Public app URL — used by Better Auth for callbacks. Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage (optional) — enables remote blob storage when set
# BLOB_READ_WRITE_TOKEN=
